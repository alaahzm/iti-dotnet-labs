@model List<lab15.Models.Student>

<h1>Student Portal — Build #@ViewBag.BuildNumber</h1>

<p>Owner: @ViewBag.Owner | Stamp A: @ViewBag.StampA | Stamp B: @ViewBag.StampB</p>

<table border="1" cellpadding="6">
    <thead>
        <tr>
            <th>Full Name</th>
            <th>Year of Study</th>
            <th>GPA</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var student in Model)
        {
            <tr>
                <td>@student.FullName</td>
                <td>@student.YearOfStudy</td>
                <td>@student.Gpa.ToString("F2")</td>
            </tr>
        }
    </tbody>
</table>